# Project Sentinel â€” environment configuration (Sprint 15, native install)
# Copy to .env and adjust. All variables are optional; defaults are safe.
# The backend reads this file from the repo root (docs/02 Â§4.2).

# --- Server ---
# SENTINEL_HOST=127.0.0.1
# SENTINEL_PORT=8000

# --- Storage (relative to repo root) ---
# SENTINEL_DB_PATH=data/sqlite/sentinel.db
# SENTINEL_CHROMA_PATH=data/chroma

# --- AI (Ollama) ---
# SENTINEL_OLLAMA_HOST=http://localhost:11434
# SENTINEL_OLLAMA_MODEL=llama3.1:8b
# SENTINEL_OLLAMA_NUM_CTX=32768   # context window sent to Ollama (default 2048 truncates long summaries)
# SENTINEL_OLLAMA_TIMEOUT_SECONDS=1800  # per-request read timeout; a v1.17.6.6 summary
#                                      # (~10k-token prefill) can outgrow 600 s during a full re-index
# SENTINEL_OLLAMA_SUMMARY_MAX_TOKENS=1250  # architecture-summary output cap (chat stays at 500)
# SENTINEL_EMBEDDING_MODEL=nomic-embed-text

# --- Projects ---
# Directories scanned for known repos (docs/01 Rule 5: known projects only).
# Defaults to the current user's home directory â€” no setup needed unless you
# want repos somewhere else (e.g. C:\Users\james).
# SENTINEL_WATCH_DIRS=C:\Users\james

# --- Repo auto-sync (Sprint 12.1; optional since v1.17.7) ---
# Read-only GitHub PAT. When set, the repo-sync beat task clones any repos not
# yet present in the watch dirs and runs `git pull --ff-only` on existing
# checkouts every SENTINEL_SYNC_INTERVAL_MINUTES (v1.17.1 default: 1440 =
# 24 h — a sync always runs once at startup, and the header "Sync now" button
# or `sentinel sync` forces one immediately), then re-indexes. Private
# repos clone only if the machine has git credentials configured.
# WITHOUT a token (the default local setup): local checkouts with a GitHub
# origin are indexed directly from the watch dirs — no GitHub contact at all.
# SENTINEL_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# SENTINEL_SYNC_INTERVAL_MINUTES=1440

# --- Security scans (v1.17.7) ---
# The daily security scan-all runs on its own beat — independent of the
# (optional) GitHub sync, so tokenless installs still scan every day.
# SENTINEL_SCAN_INTERVAL_MINUTES=1440

# --- Knowledge indexing (v1.17) ---
# After each startup scan, queue RAG indexing for projects that still have
# unembedded files (Ollama-gated). Set to false to disable.
# SENTINEL_AUTO_INDEX_KNOWLEDGE=true

# --- Security ---
# SENTINEL_API_KEY=

# --- Scheduler ---
# SENTINEL_SCHEDULE_INTERVAL=60
