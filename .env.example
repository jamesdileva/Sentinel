# Project Sentinel — environment configuration
# Copy to .env and adjust. All variables are optional; defaults are safe.
# In Docker Compose, these interpolate into docker-compose.yml (docs/02 §13.4).

# --- Server ---
# SENTINEL_HOST=127.0.0.1
# SENTINEL_PORT=8000
# SENTINEL_API_PORT=8000

# --- Storage ---
# SENTINEL_DB_PATH=data/sqlite/sentinel.db
# SENTINEL_CHROMA_PATH=data/chroma

# --- AI (Ollama) ---
# Compose default points at the laptop's shared Ollama (192.168.4.40:11434).
# SENTINEL_OLLAMA_HOST=http://localhost:11434
# SENTINEL_OLLAMA_MODEL=gemma2
# SENTINEL_EMBEDDING_MODEL=nomic-embed-text

# --- Projects ---
# SENTINEL_WATCH_DIRS=C:\Users\j
# Host folder mounted into containers at /data/projects. On the laptop point
# this at a local folder the repo-sync service keeps in sync with GitHub
# (cloned under owner/name, e.g. C:\Users\james\projects).
# SENTINEL_PROJECTS_DIR=C:\Projects\sentinel-projects

# --- Home server status (System page, Sprint 12) ---
# Pi-hole v6 read-only API (session auth — the static X-FTL-API-KEY header no
# longer exists in v6). SENTINEL_PIHOLE_HOST is the Pi-hole web port and
# SENTINEL_PIHOLE_PASSWORD is the same password as the Pi-hole web admin.
# SENTINEL_PIHOLE_HOST=http://192.168.4.40:8053
# SENTINEL_PIHOLE_PASSWORD=<pi-hole web admin password>

# --- Repo auto-sync (Sprint 12.1) ---
# Read-only GitHub PAT. When set, the repo-sync beat task clones any repos not
# yet present in the projects dir and runs `git pull --ff-only` on existing
# checkouts every SENTINEL_SYNC_INTERVAL_MINUTES, then re-indexes. Private
# repos clone only if the machine has git credentials configured.
# SENTINEL_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# SENTINEL_SYNC_INTERVAL_MINUTES=15

# --- Pi-hole (docker compose --profile pihole) ---
# PIHOLE_WEBPASSWORD=<set a strong admin password>

# --- Security ---
# SENTINEL_API_KEY=

# --- Scheduler ---
# SENTINEL_SCHEDULE_INTERVAL=60
