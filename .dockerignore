# Docker build context is the repo root; keep image layers lean.
.git/
.venv/
venv/
**/__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / frontend
node_modules/
frontend/
frontend/dist/
frontend/.vite/

# Environment & secrets
.env
.env.local
*.pem
*.key

# Runtime data (never baked into images; mounted at runtime)
data/

# Logs
*.log
logs/

# Docs and tooling (not needed in the image)
docs/
config/
.idea/
.vscode/
.gitkeep
AGENTS.md
README.md
